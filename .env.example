# ===== Envio dos e-mails de orçamento pelo Brevo (brevo.com) =====
# RECOMENDADO: chave de API (envia por HTTPS, funciona em qualquer rede e na Vercel).
# Brevo > Configurações (engrenagem) > SMTP e API > aba "Chaves de API" > Gerar nova chave (começa com xkeysib-)
BREVO_API_KEY=

# Alternativa por SMTP (muitas redes bloqueiam as portas de SMTP; só é usada se BREVO_API_KEY estiver vazia)
# Os dados ficam no Brevo em: Configurações (engrenagem) > SMTP e API > aba SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# "Login" que o Brevo mostra (parece um e-mail, ex.: 8a1b2c001@smtp-brevo.com)
SMTP_USER=
# "Chave SMTP" gerada no Brevo (começa com xsmtpsib-...)
SMTP_PASS=

# Remetente que o cliente vê (precisa estar verificado em Remetentes no Brevo)
MAIL_FROM=VitalCare <vitalcarecontatar@gmail.com>
# E-mail da equipe que recebe o aviso de cada pedido
MAIL_TO=vitalcarecontatar@gmail.com

# ===== Banco de dados MySQL (servidor da escola) =====
# Teste com:  npm run banco
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=alunos_gabrielyabreu

# Login com Google: "ID do cliente" criado em console.cloud.google.com (termina com .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Assistentes de IA (site e Vital). GRATUITO: Google Gemini
# aistudio.google.com > entre com a conta Google > "Get API key" > "Create API key" (começa com AIza)
# Sem chave nenhuma, as assistentes usam respostas prontas (funciona, mas sem conversa livre).
GEMINI_API_KEY=
# Opcional (pago): Claude API, console.anthropic.com > API Keys. Só é usada se GEMINI_API_KEY estiver vazia.
ANTHROPIC_API_KEY=
